NODE_ENV=production
APP_PORT=3000
POSTGRES_DB=postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=postgres_password


DB_PORT=5432
DB_NAME=postgres
DB_USER=user
DB_PASSWORD=postgres_password
JWT_SECRET=( openssl rand -hex 24 )

ADMIN_INITIAL_PASSWORD=your_initial_password

# POSTGRES_xx and DB_xx should be the same

# ZITADEL OIDC (create a confidential Web application using Authorization Code + PKCE)
ZITADEL_ISSUER=https://auth.mesina.farm
ZITADEL_CLIENT_ID=replace_with_zitadel_client_id
ZITADEL_CLIENT_SECRET=replace_with_zitadel_client_secret
CRM_PUBLIC_URL=https://crm.mesina.farm
ZITADEL_REDIRECT_URI=https://crm.mesina.farm/api/auth/callback/zitadel
ZITADEL_POST_LOGOUT_URI=https://crm.mesina.farm
ZITADEL_DEFAULT_CRM_ROLE=Sales Agent
# Set this to the verified email of the existing seeded CRM Admin for first-time Admin linking.
ZITADEL_BOOTSTRAP_ADMIN_EMAIL=

# Number of trusted reverse-proxy hops. Keep 0 for direct access; set to 1 when
# exactly one trusted reverse proxy sits in front of the CRM.
TRUST_PROXY=0
